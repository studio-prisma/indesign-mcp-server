{
  "name": "indesign-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Adobe InDesign automation. Windows and macOS, with validated tool arguments and a test suite.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --inspect index.js",
    "test": "node --test test/scripts.test.mjs test/injection.test.mjs test/layout.test.mjs test/arrange.test.mjs",
    "lint": "node --check index.js && node --check lib/indesign-driver.js && node --check lib/jsx-safe.js && node --check lib/layout-tools.js && node --check lib/arrange-tools.js && node --check lib/flow-tools.js",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e-layout": "node scripts/e2e-layout.mjs",
    "e2e-arrange": "node scripts/e2e-arrange.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "indesign",
    "adobe",
    "automation",
    "publishing",
    "desktop-publishing",
    "windows"
  ],
  "author": "studio-prisma",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studio-prisma/indesign-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/studio-prisma/indesign-mcp-server/issues"
  },
  "homepage": "https://github.com/studio-prisma/indesign-mcp-server#readme",
  "files": [
    "index.js",
    "lib/",
    "scripts/",
    "README.md",
    "LICENSE"
  ]
}
